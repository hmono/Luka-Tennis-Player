# REVIEW-ONLY candidate. Do not install or reload on the audited host.
# This file belongs inside nginx's http context. DNS/cert paths are placeholders.
# Qualify an isolated host, trusted certificate, firewall and monitoring first.
limit_conn_zone $binary_remote_addr zone=atp_ops_clients:32k;
limit_req_zone $binary_remote_addr zone=atp_ops_rate:32k rate=2r/s;

server {
    listen 443 ssl;
    server_name ops-inbox.example.invalid;
    ssl_certificate /REQUIRES_PROVISIONING/fullchain.pem;
    ssl_certificate_key /REQUIRES_PROVISIONING/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/atp-ops-inbox-error.log crit;
    client_max_body_size 8k;
    client_body_timeout 5s;
    client_header_timeout 5s;
    send_timeout 5s;
    keepalive_timeout 0;
    limit_conn atp_ops_clients 4;
    limit_conn_status 503;
    limit_req zone=atp_ops_rate burst=4 nodelay;
    limit_req_status 503;

    location ~ ^/(events|health)$ {
        proxy_pass http://127.0.0.1:8765;
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_connect_timeout 1s;
        proxy_send_timeout 2s;
        proxy_read_timeout 3s;
        proxy_next_upstream off;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection close;
    }
    location / { return 404; }
}
