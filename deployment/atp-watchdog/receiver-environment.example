# Install root-owned mode 0600 at /etc/atp-ops-inbox.env.
ATP_OPS_RECEIVER_ENABLED=false
ATP_OPS_RECEIVER_TOKEN=
# Provision separate destination for operational notifications.
# Forwarding is at least once on ambiguity; receiver inbox deduplicates event_id.
ATP_OPS_FORWARD_URL=
ATP_OPS_FORWARD_TOKEN=
